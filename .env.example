# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. Never commit secrets.
#
# Settings are loaded by pydantic-settings (see src/fusionserve/config.py).
# All keys are uppercased; nested keys use `__` as the delimiter.

# ---- Application ----
APP_NAME=FusionServe
LOG_LEVEL=INFO
DEBUG=False
BASE_PATH=/api

# ---- UI ----
# The SPA is served from prebuilt assets shipped under
# ``src/fusionserve/web/dist`` (run ``pnpm run build`` in ``ui/`` to
# regenerate them). For frontend development run ``pnpm run dev`` in
# ``ui/``; the Angular dev server proxies ``/api`` to this backend.

# Public URL where the Angular SPA is mounted. Defaults to
# ``f"{BASE_PATH}/-/"`` (i.e. ``/api/-/`` with the default BASE_PATH).
# Angular emits its browser bundle (with relative asset URLs) under an
# ``assets/`` prefix, so the chunks are served at ``<UI_PATH>assets/...``
# — there is no separate asset prefix to configure.
# UI_PATH=/api/-/

# ---- PostgreSQL ----
PG_USER=fusionserve
PG_PASSWORD=changeme
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=fusionserve
PG_APP_SCHEMA=app_public
ECHO_SQL=False

# Role used when no Authorization header is present.
ANONYMOUS_ROLE=fusionserve

# ---- Pagination ----
MAX_PAGE_SIZE=1000

# ---- File uploads / storage ----
# See docs/features/file_uploads.md for the full feature reference,
# including the required ``uploads`` metadata table DDL.

# Backend selector. Built-in values are ``s3`` and ``azure`` (the
# latter is an unimplemented placeholder); any other value is treated
# as a ``"pkg.mod:ClassName"`` dotted import path resolved at startup.
# STORAGE_BACKEND=s3

# Name of the metadata table (in PG_APP_SCHEMA). The feature
# gracefully disables when this table is absent.
# STORAGE_METADATA_TABLE=uploads

# Per-file size cap (bytes), enforced at the /complete step by HEAD-ing
# the uploaded object.
# STORAGE_MAX_SINGLE_FILE_BYTES=104857600  # 100 MiB per-file cap

# When true, the presigned upload/download URLs handed to clients are
# rewritten to route through FusionServe's own HTTP proxy so clients
# never contact the object store directly. Off by default.
# STORAGE_PROXY_URLS=false

# S3 backend (nested settings use ``__`` delimiter).
# STORAGE_S3__BUCKET=fusionserve-uploads
# STORAGE_S3__REGION=eu-central-1
# STORAGE_S3__ENDPOINT_URL=                # MinIO / LocalStack
# STORAGE_S3__ACCESS_KEY_ID=
# STORAGE_S3__SECRET_ACCESS_KEY=
# STORAGE_S3__PRESIGN_TTL_SECONDS=3600     # upload + download URL TTL

# ---- JWT / OIDC ----
# Either set JWKS_URL directly, or set JWT_ISSUER and let the OIDC
# .well-known/openid-configuration document supply jwks_uri.
# JWT_ISSUER=https://auth.example.com/realms/myrealm
# JWKS_URL=https://auth.example.com/realms/myrealm/protocol/openid-connect/certs
# CLIENT_ID=fusionserve
